# Token from Holyrics -> Settings -> API Server -> Manage permissions.
HOLYRICS_TOKEN=

# Default Holyrics local API address is http://localhost:8091.
# If Holyrics API Server uses another port, change HOLYRICS_PORT.
HOLYRICS_HOST=http://localhost
HOLYRICS_PORT=8091

# Optional fallback for non-interactive runs.
# Normal interactive startup asks the operator to choose a theme from GetThemes.
# Empty means: use Holyrics Bible module default theme.
HOLYRICS_THEME=
