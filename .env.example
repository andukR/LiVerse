# Token from Holyrics -> Settings -> API Server -> Manage permissions.
HOLYRICS_TOKEN=

# Default Holyrics local API address is http://localhost:8091.
# If Holyrics API Server uses another port, change HOLYRICS_PORT.
HOLYRICS_HOST=http://localhost
HOLYRICS_PORT=8091

# Optional fallback for runs without a sermon plan.
# With --sermon-plan, LiVerse copies the theme of the current plan presentation.
# Empty means: use Holyrics Bible module default theme when no plan theme is available.
HOLYRICS_THEME=

# Optional: recognize both spoken Bible addresses and fragments of verse text.
# Put bible_index.db in the project's bible_index folder before enabling this.
# LIVERSE_CITATION_DETECTION_MODE=hybrid_confirm
